# Postgres na VPS. Ex: postgresql://usuario:senha@seu-ip-ou-dominio:5432/g6pd_db
DATABASE_URL="postgresql://usuario:senha@localhost:5432/g6pd_db"

# Chave da API Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY="sk-ant-..."

# Segredo usado para assinar os JWT do painel admin. Gere um valor aleatorio forte.
JWT_SECRET="troque-por-um-valor-aleatorio-longo"

# Prefixo secreto das rotas de admin (nao versionar um valor previsivel).
# Gerado automaticamente para este projeto: adm-fa9f7fddea46
ADMIN_ROUTE_SLUG="adm-fa9f7fddea46"

# Porta do servidor Express
PORT=3333

# Origens permitidas por CORS (separadas por virgula). Inclua a URL do app mobile em dev.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
